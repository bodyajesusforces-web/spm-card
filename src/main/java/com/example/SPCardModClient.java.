package com.example.spcard;

import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.minecraft.text.Text;

public class SPCardModClient implements ClientModInitializer {
    private boolean wasSneaking = false;

    @Override
    public void onInitializeClient() {
        // При старте игры можно запросить данные один раз
        // CardService.updateCard("https://твой-сайт/api", "твой_токен");

        ClientTickEvents.END_CLIENT_TICK.register(client -> {
            if (client.player == null) return;

            // Проверяем, зажата ли клавиша Shift (приседание)
            boolean isSneaking = client.options.sneakKey.isPressed();

            // Срабатывает ровно один раз в момент нажатия
            if (isSneaking && !wasSneaking) {
                String number = CardService.getCardNumber();
                // Вывод в ActionBar (второй аргумент true)
                client.player.sendMessage(Text.literal("§6Карта: §e" + number), true);
            }

            wasSneaking = isSneaking;
        });
    }
}
